/* ─── Animated counter hook ─── */
function useCountUp(end, duration = 2000) {
  const [count, setCount] = useState(0);
  const ref = useRef(null);
  const hasAnimated = useRef(false);

  useEffect(() => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !hasAnimated.current) {
          hasAnimated.current = true;
          const start = 0;
          const startTime = performance.now();
          const animate = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // ease-out cubic
            const eased = 1 - Math.pow(1 - progress, 3);
            setCount(Math.floor(start + (end - start) * eased));
            if (progress < 1) requestAnimationFrame(animate);
          };
          requestAnimationFrame(animate);
        }
      },
      { threshold: 0.3 }
    );
    if (ref.current) observer.observe(ref.current);
    return () => observer.disconnect();
  }, [end, duration]);

  return [count, ref];
}

/* ─── Single Deliverable Section Component ─── */
function DeliverableSection({ item, index, applyUrl }) {
  const isReversed = index % 2 !== 0;
  const Icon = item.icon;

  return (
    <section
      className="relative py-20 md:py-28 overflow-hidden"
      style={{ backgroundColor: index % 2 === 0 ? "#ffffff" : "#FAFBFC" }}
    >
      {/* Subtle decorative orb */}
      <div
        className="absolute w-[500px] h-[500px] rounded-full blur-[120px] opacity-[0.06] pointer-events-none"
        style={{
          background: item.gradient,
          top: isReversed ? "auto" : "-10%",
          bottom: isReversed ? "-10%" : "auto",
          right: isReversed ? "auto" : "-5%",
          left: isReversed ? "-5%" : "auto",
        }}
      />

      <div className="max-w-7xl mx-auto px-6 md:px-10 relative z-10">
        <div
          className={`flex flex-col ${isReversed ? "lg:flex-row-reverse" : "lg:flex-row"
            } gap-12 lg:gap-20 items-start`}
        >
          {/* Left/Right: Content */}
          <div className="flex-1 w-full" data-aos="fade-up">
            {/* Number + Label */}
            <div className="flex items-center gap-4 mb-6">
              <span
                className="inline-flex items-center justify-center w-11 h-11 rounded-xl text-white text-sm font-bold"
                style={{ background: item.gradient }}
              >
                {item.number}
              </span>
              <span
                className="text-xs font-bold uppercase tracking-[0.2em]"
                style={{ color: item.accent }}
              >
                {item.label}
              </span>
            </div>

            {/* Heading */}
            <h2 className="text-3xl md:text-4xl lg:text-[2.75rem] font-bold text-slate-900 tracking-tight leading-[1.15] mb-6">
              {item.heading}
            </h2>

            {/* Description */}
            <p className="text-lg md:text-xl text-slate-600 leading-relaxed mb-8 max-w-2xl">
              {item.description}
            </p>

            {/* Lead text */}
            {item.lead && (
              <p className="text-base md:text-lg font-semibold text-slate-800 mb-5">
                {item.lead}
              </p>
            )}

            {/* Bullets */}
            {item.bullets.length > 0 && (
              <ul className="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 mb-8">
                {item.bullets.map((b) => (
                  <li
                    key={b}
                    className="flex items-start gap-3 text-base text-slate-600"
                  >
                    <CheckCircle2
                      size={18}
                      className="mt-0.5 shrink-0"
                      style={{ color: item.accent }}
                    />
                    {b}
                  </li>
                ))}
              </ul>
            )}

            {/* Closing note */}
            {item.closing && (
              <div
                className="rounded-xl px-5 py-4 border"
                style={{
                  backgroundColor: item.accentLight,
                  borderColor: item.accentBorder,
                }}
              >
                <p className="text-sm md:text-base text-slate-700 leading-relaxed">
                  {item.closing}
                </p>
              </div>
            )}
          </div>

          {/* Right/Left: Visual Card */}
          <div
            className="flex-shrink-0 w-full lg:w-[340px] xl:w-[380px]"
            data-aos={isReversed ? "fade-right" : "fade-left"}
            data-aos-delay="200"
          >
            <div
              className="relative rounded-3xl p-8 md:p-10 border overflow-hidden"
              style={{
                backgroundColor: item.accentLight,
                borderColor: item.accentBorder,
              }}
            >
              {/* Background pattern */}
              <div
                className="absolute inset-0 opacity-[0.04]"
                style={{
                  backgroundImage: `radial-gradient(${item.accent} 1px, transparent 1px)`,
                  backgroundSize: "24px 24px",
                }}
              />

              <div className="relative z-10 flex flex-col items-center text-center">
                <div
                  className="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 shadow-lg"
                  style={{ background: item.gradient }}
                >
                  <Icon size={36} className="text-white" />
                </div>
                <h3
                  className="text-xl font-bold mb-3"
                  style={{ color: item.accent }}
                >
                  {item.label}
                </h3>
                <p className="text-sm text-slate-500 leading-relaxed mb-6">
                  Part of the Career Ready India programme delivered to your
                  school at no cost.
